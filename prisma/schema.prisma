// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Shoe {
  shoe_id Int @id @default(autoincrement())
  name String
  price Float
  shoesize Shoesize[]
  description String
  img String
}

model Shoesize {
  shoesize_id Int @id @default(autoincrement())
  shoe Shoe @relation(fields: [shoe_id], references: [shoe_id])
  shoe_id Int
  size Int
}
